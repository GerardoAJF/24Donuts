# Puerto donde corre el servidor Express
PORT=4000

# Cadena de conexión a MongoDB
MONGODB_URI=mongodb://localhost:27017/24donuts

# Secreto usado para firmar los JWT de sesión y de verificación/recuperación
JWT_Secret_key=cambia-esto-por-un-secreto-largo-y-aleatorio

# Credenciales del correo emisor (usar contraseña de aplicación de Gmail, no la contraseña normal)
SENDER_EMAIL=tucorreo@gmail.com
SENDER_PASSWORD=contraseña-de-aplicacion

# URL del frontend (usada en CORS y en enlaces de los correos)
FRONTEND_URL=http://localhost:5173
